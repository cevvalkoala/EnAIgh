{
  "manifest_version": 3,
  "name": "EnAIgh",
  "version": "1.1.1",
  "description": "Hide YouTube videos carrying its Made with AI disclosure.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "icons": {
    "16": "extension/icons/on/icon-16.png",
    "32": "extension/icons/on/icon-32.png",
    "48": "extension/icons/on/icon-48.png",
    "96": "extension/icons/on/icon-96.png",
    "128": "extension/icons/store/icon-store-128-on.png"
  },
  "background": {
    "service_worker": "extension/background.js"
  },
  "action": {
    "default_title": "EnAIgh",
    "default_icon": {
      "16": "extension/icons/on/icon-16.png",
      "32": "extension/icons/on/icon-32.png",
      "48": "extension/icons/on/icon-48.png",
      "96": "extension/icons/on/icon-96.png",
      "128": "extension/icons/on/icon-128.png"
    }
  },
  "options_ui": {
    "page": "extension/options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["extension/content.css"],
      "js": ["extension/settings.js", "extension/content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-ai-label-blocker@enaigh.local",
      "strict_min_version": "109.0"
    }
  }
}
